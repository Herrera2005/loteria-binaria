  id                        String              @id @db.Uuid
  prize_award_id            String              @unique @db.Uuid
  status                    AwardPaymentStatus
  ledger_transaction_id     String?             @unique @db.Uuid
  idempotency_key_id        String              @db.Uuid
  attempt_count             Int
  credited_at               DateTime?           @db.Timestamptz(6)
  last_error                String?             @db.Text
  created_at                DateTime            @default(now()) @db.Timestamptz(6)
  updated_at                DateTime            @default(now()) @updatedAt @db.Timestamptz(6)
  rel_prize_award_id        PrizeAwards         @relation("fk_award_payment_orders_prize_award_id", fields: [prize_award_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  rel_ledger_transaction_id LedgerTransactions? @relation("fk_award_payment_orders_ledger_transaction_id", fields: [ledger_transaction_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  rel_idempotency_key_id    IdempotencyKeys     @relation("fk_award_payment_orders_idempotency_key_id", fields: [idempotency_key_id], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([status, updated_at], map: "ix_award_payment_orders_status_updated_at")
  @@map("award_payment_orders")
}

/// Commitment y semilla cifrada.
model DrawCommitments {
  id                                  String           @id @db.Uuid
  draw_event_id                       String           @unique @db.Uuid
  status                              CommitmentStatus
  algorithm_version                   String           @db.VarChar(50)
  commitment_hash                     String           @unique @db.VarChar(128)
  encrypted_secret_seed               Bytes            @db.ByteA
  encryption_key_version              String           @db.VarChar(50)
  published_at                        DateTime?        @db.Timestamptz(6)
  revealed_seed                       String?          @db.Text
  revealed_at                         DateTime?        @db.Timestamptz(6)
  created_at                          DateTime         @default(now()) @db.Timestamptz(6)
  updated_at                          DateTime         @default(now()) @updatedAt @db.Timestamptz(6)
  rel_draw_event_id                   DrawEvents       @relation("fk_draw_commitments_draw_event_id", fields: [draw_event_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  rev_draw_results_draw_commitment_id DrawResults?     @relation("fk_draw_results_draw_commitment_id")

  @@index([status], map: "ix_draw_commitments_status")
  @@map("draw_commitments")
}

/// Símbolos ganadores y orden visual.
model DrawResultNumbers {
  id                 String      @id @db.Uuid
  draw_result_id     String      @db.Uuid
  symbol             String      @db.VarChar(2)
  display_order      Int         @db.SmallInt
  created_at         DateTime    @default(now()) @db.Timestamptz(6)
  rel_draw_result_id DrawResults @relation("fk_draw_result_numbers_draw_result_id", fields: [draw_result_id], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([draw_result_id, symbol], map: "uq_draw_result_numbers_draw_result_id_symbol")
  @@unique([draw_result_id, display_order], map: "uq_draw_result_numbers_draw_result_id_display_order")
  @@map("draw_result_numbers")
}

/// Resultado único e inmutable.
model DrawResults {
  id                                     String              @id @db.Uuid
  draw_event_id                          String              @unique @db.Uuid
  draw_commitment_id                     String              @unique @db.Uuid
  draw_snapshot_id                       String              @unique @db.Uuid
  algorithm_version                      String              @db.VarChar(50)
  final_seed_hash                        String              @db.VarChar(128)
  result_hash                            String              @unique @db.VarChar(128)
  fixed_at                               DateTime            @db.Timestamptz(6)
  fixed_by_job_run_id                    String?             @db.Uuid
  created_at                             DateTime            @default(now()) @db.Timestamptz(6)
  rel_draw_event_id                      DrawEvents          @relation("fk_draw_results_draw_event_id", fields: [draw_event_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  rel_draw_commitment_id                 DrawCommitments     @relation("fk_draw_results_draw_commitment_id", fields: [draw_commitment_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  rel_draw_snapshot_id                   DrawSnapshots       @relation("fk_draw_results_draw_snapshot_id", fields: [draw_snapshot_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  rel_fixed_by_job_run_id                JobRuns?            @relation("fk_draw_results_fixed_by_job_run_id", fields: [fixed_by_job_run_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  rev_draw_result_numbers_draw_result_id DrawResultNumbers[] @relation("fk_draw_result_numbers_draw_result_id")
  rev_result_reports_draw_result_id      ResultReports[]     @relation("fk_result_reports_draw_result_id")
  rev_ticket_evaluations_draw_result_id  TicketEvaluations[] @relation("fk_ticket_evaluations_draw_result_id")
  rev_ticket_evaluations_result_event    TicketEvaluations[] @relation("fk_evaluation_result_event")

  @@unique([id, draw_event_id], map: "uq_draw_result_event")
  @@map("draw_results")
}

/// Contenido relacional del snapshot.
model DrawSnapshotTickets {
  id                   String        @id @db.Uuid
  draw_snapshot_id     String        @db.Uuid
  ticket_id            String        @db.Uuid
  sequence             Int
  ticket_hash          String        @db.VarChar(128)
  created_at           DateTime      @default(now()) @db.Timestamptz(6)
  rel_draw_snapshot_id DrawSnapshots @relation("fk_draw_snapshot_tickets_draw_snapshot_id", fields: [draw_snapshot_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  rel_ticket_id        Tickets       @relation("fk_draw_snapshot_tickets_ticket_id", fields: [ticket_id], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([draw_snapshot_id, ticket_id], map: "uq_draw_snapshot_tickets_draw_snapshot_id_ticket_id")
  @@unique([draw_snapshot_id, sequence], map: "uq_draw_snapshot_tickets_draw_snapshot_id_sequence")
  @@map("draw_snapshot_tickets")
}

/// Snapshot de boletos elegibles.
model DrawSnapshots {
  id                                         String                @id @db.Uuid
  draw_event_id                              String                @unique @db.Uuid
  status                                     SnapshotStatus
  snapshot_hash                              String?               @unique @db.VarChar(128)
  ticket_count                               Int
  serialization_version                      String                @db.VarChar(40)
  generated_at                               DateTime?             @db.Timestamptz(6)
  created_at                                 DateTime              @default(now()) @db.Timestamptz(6)
  updated_at                                 DateTime              @default(now()) @updatedAt @db.Timestamptz(6)
  rel_draw_event_id                          DrawEvents            @relation("fk_draw_snapshots_draw_event_id", fields: [draw_event_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  rev_draw_results_draw_snapshot_id          DrawResults?          @relation("fk_draw_results_draw_snapshot_id")
  rev_draw_snapshot_tickets_draw_snapshot_id DrawSnapshotTickets[] @relation("fk_draw_snapshot_tickets_draw_snapshot_id")

  @@index([status], map: "ix_draw_snapshots_status")
  @@map("draw_snapshots")
}

/// Obligación calculada por boleto y categoría.
model PrizeAwards {
  id                                      String              @id @db.Uuid
  draw_event_id                           String              @db.Uuid
  ticket_id                               String              @db.Uuid

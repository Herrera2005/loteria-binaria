/// Reservas dentro del carrito.
model CartItems {
  id                          String                  @id @db.Uuid
  shopping_cart_id            String                  @db.Uuid
  reservation_id              String                  @unique @db.Uuid
  combination_id              String                  @db.Uuid
  unit_price_virtual_minor    BigInt
  added_at                    DateTime                @db.Timestamptz(6)
  created_at                  DateTime                @default(now()) @db.Timestamptz(6)
  rel_shopping_cart_id        ShoppingCarts           @relation("fk_cart_items_shopping_cart_id", fields: [shopping_cart_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  rel_reservation_id          CombinationReservations @relation("fk_cart_items_reservation_id", fields: [reservation_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  rel_reservation_combination CombinationReservations @relation("fk_cart_item_reservation_combination", fields: [reservation_id, combination_id], references: [id, combination_id], onDelete: Restrict, onUpdate: Cascade, map: "fk_cart_item_reservation_combination")
  rel_combination_id          EventCombinations       @relation("fk_cart_items_combination_id", fields: [combination_id], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([shopping_cart_id, combination_id], map: "uq_cart_items_shopping_cart_id_combination_id")
  @@map("cart_items")
}

/// Reserva exclusiva de hasta cinco minutos, limitada por el cierre.
model CombinationReservations {
  id                                     String            @id @db.Uuid
  combination_id                         String            @db.Uuid
  draw_event_id                          String            @db.Uuid
  user_id                                String            @db.Uuid
  purchase_session_id                    String            @db.Uuid
  status                                 ReservationStatus
  reserved_at                            DateTime          @db.Timestamptz(6)
  expires_at                             DateTime          @db.Timestamptz(6)
  consumed_at                            DateTime?         @db.Timestamptz(6)
  released_at                            DateTime?         @db.Timestamptz(6)
  created_at                             DateTime          @default(now()) @db.Timestamptz(6)
  rel_combination_id                     EventCombinations @relation("fk_combination_reservations_combination_id", fields: [combination_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  rel_draw_event_id                      DrawEvents        @relation("fk_combination_reservations_draw_event_id", fields: [draw_event_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  rel_user_id                            Users             @relation("fk_combination_reservations_user_id", fields: [user_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  rel_purchase_session_id                PurchaseSessions  @relation("fk_combination_reservations_purchase_session_id", fields: [purchase_session_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  rel_combination_event                  EventCombinations @relation("fk_reservation_combination_event", fields: [combination_id, draw_event_id], references: [id, draw_event_id], onDelete: Restrict, onUpdate: Cascade, map: "fk_reservation_combination_event")
  rel_session_owner_event                PurchaseSessions  @relation("fk_reservation_session_owner_event", fields: [purchase_session_id, user_id, draw_event_id], references: [id, user_id, draw_event_id], onDelete: Restrict, onUpdate: Cascade, map: "fk_reservation_session_owner_event")
  rev_cart_items_reservation_id          CartItems?        @relation("fk_cart_items_reservation_id")
  rev_cart_items_reservation_combination CartItems[]       @relation("fk_cart_item_reservation_combination")

  @@unique([id, combination_id], map: "uq_reservation_combination")
  @@index([user_id, draw_event_id, status], map: "ix_combination_reservations_user_id_draw_event_id_status")
  @@index([expires_at], map: "ix_combination_reservations_expires_at")
  @@map("combination_reservations")
}

/// Orden idempotente que confirma boletos.
model PurchaseOrders {
  id                            String              @id @db.Uuid
  public_id                     String              @unique @db.VarChar(40)
  user_id                       String              @db.Uuid
  draw_event_id                 String              @db.Uuid
  shopping_cart_id              String              @unique @db.Uuid
  status                        PurchaseOrderStatus
  ticket_count                  Int
  total_virtual_minor           BigInt
  ledger_transaction_id         String?             @unique @db.Uuid
  idempotency_key_id            String              @db.Uuid
  confirmed_at                  DateTime?           @db.Timestamptz(6)
  rejection_code                String?             @db.VarChar(80)
  created_at                    DateTime            @default(now()) @db.Timestamptz(6)
  updated_at                    DateTime            @default(now()) @updatedAt @db.Timestamptz(6)
  rel_user_id                   Users               @relation("fk_purchase_orders_user_id", fields: [user_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  rel_draw_event_id             DrawEvents          @relation("fk_purchase_orders_draw_event_id", fields: [draw_event_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  rel_shopping_cart_id          ShoppingCarts       @relation("fk_purchase_orders_shopping_cart_id", fields: [shopping_cart_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  rel_cart_owner_event          ShoppingCarts       @relation("fk_order_cart_owner_event", fields: [shopping_cart_id, user_id, draw_event_id], references: [id, user_id, draw_event_id], onDelete: Restrict, onUpdate: Cascade, map: "fk_order_cart_owner_event")
  rel_ledger_transaction_id     LedgerTransactions? @relation("fk_purchase_orders_ledger_transaction_id", fields: [ledger_transaction_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  rel_idempotency_key_id        IdempotencyKeys     @relation("fk_purchase_orders_idempotency_key_id", fields: [idempotency_key_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  rev_tickets_purchase_order_id Tickets[]           @relation("fk_tickets_purchase_order_id")
  rev_tickets_order_owner_event Tickets[]           @relation("fk_ticket_order_owner_event")

  @@unique([id, user_id, draw_event_id], map: "uq_purchase_order_owner_event")
  @@map("purchase_orders")
}

/// Sesión temporal de compra.
model PurchaseSessions {
  id                                               String                    @id @db.Uuid
  user_id                                          String                    @db.Uuid
  draw_event_id                                    String                    @db.Uuid
  status                                           PurchaseSessionStatus
  expires_at                                       DateTime                  @db.Timestamptz(6)
  completed_at                                     DateTime?                 @db.Timestamptz(6)
  created_at                                       DateTime                  @default(now()) @db.Timestamptz(6)
  updated_at                                       DateTime                  @default(now()) @updatedAt @db.Timestamptz(6)
  rel_user_id                                      Users                     @relation("fk_purchase_sessions_user_id", fields: [user_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  rel_draw_event_id                                DrawEvents                @relation("fk_purchase_sessions_draw_event_id", fields: [draw_event_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  rev_combination_reservations_purchase_session_id CombinationReservations[] @relation("fk_combination_reservations_purchase_session_id")
  rev_combination_reservations_session_owner_event CombinationReservations[] @relation("fk_reservation_session_owner_event")
  rev_shopping_carts_purchase_session_id           ShoppingCarts?            @relation("fk_shopping_carts_purchase_session_id")
  rev_shopping_carts_session_owner_event           ShoppingCarts[]           @relation("fk_cart_session_owner_event")

  @@unique([id, user_id, draw_event_id], map: "uq_purchase_session_owner_event")
  @@index([user_id, status], map: "ix_purchase_sessions_user_id_status")
  @@index([expires_at], map: "ix_purchase_sessions_expires_at")
  @@map("purchase_sessions")
}

/// Carrito asociado a la sesión.
model ShoppingCarts {
  id                                   String           @id @db.Uuid
  purchase_session_id                  String           @unique @db.Uuid
  user_id                              String           @db.Uuid
  draw_event_id                        String           @db.Uuid
  status                               CartStatus
  expires_at                           DateTime         @db.Timestamptz(6)
  confirmed_at                         DateTime?        @db.Timestamptz(6)
  created_at                           DateTime         @default(now()) @db.Timestamptz(6)
  updated_at                           DateTime         @default(now()) @updatedAt @db.Timestamptz(6)
  rel_purchase_session_id              PurchaseSessions @relation("fk_shopping_carts_purchase_session_id", fields: [purchase_session_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  rel_session_owner_event              PurchaseSessions @relation("fk_cart_session_owner_event", fields: [purchase_session_id, user_id, draw_event_id], references: [id, user_id, draw_event_id], onDelete: Restrict, onUpdate: Cascade, map: "fk_cart_session_owner_event")
  rel_user_id                          Users            @relation("fk_shopping_carts_user_id", fields: [user_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  rel_draw_event_id                    DrawEvents       @relation("fk_shopping_carts_draw_event_id", fields: [draw_event_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  rev_cart_items_shopping_cart_id      CartItems[]      @relation("fk_cart_items_shopping_cart_id")
  rev_purchase_orders_shopping_cart_id PurchaseOrders?  @relation("fk_purchase_orders_shopping_cart_id")
  rev_purchase_orders_cart_owner_event PurchaseOrders[] @relation("fk_order_cart_owner_event")

  @@unique([id, user_id, draw_event_id], map: "uq_shopping_cart_owner_event")
  @@index([user_id, status], map: "ix_shopping_carts_user_id_status")
  @@map("shopping_carts")
}

/// Símbolos del boleto.
model TicketNumbers {
  id            String   @id @db.Uuid
  ticket_id     String   @db.Uuid
  symbol        String   @db.VarChar(2)
  sort_order    Int      @db.SmallInt
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  rel_ticket_id Tickets  @relation("fk_ticket_numbers_ticket_id", fields: [ticket_id], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([ticket_id, symbol], map: "uq_ticket_numbers_ticket_id_symbol")
  @@unique([ticket_id, sort_order], map: "uq_ticket_numbers_ticket_id_sort_order")
  @@map("ticket_numbers")
}

/// Historial multidimensional de propiedad, evaluación y crédito.
model TicketStatusHistory {
  id                String    @id @db.Uuid
  ticket_id         String    @db.Uuid
  dimension         String    @db.VarChar(30)
  from_status       String?   @db.VarChar(50)
  to_status         String    @db.VarChar(50)
  transition_code   String    @db.VarChar(80)
  actor_type        ActorType
  actor_user_id     String?   @db.Uuid
  reason            String?   @db.Text
  correlation_id    String    @db.Uuid
  occurred_at       DateTime  @db.Timestamptz(6)
  created_at        DateTime  @default(now()) @db.Timestamptz(6)
  rel_ticket_id     Tickets   @relation("fk_ticket_status_history_ticket_id", fields: [ticket_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  rel_actor_user_id Users?    @relation("fk_ticket_status_history_actor_user_id", fields: [actor_user_id], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([ticket_id, occurred_at], map: "ix_ticket_status_history_ticket_id_occurred_at")
  @@map("ticket_status_history")
}

/// Boleto pagado e inmutable.
model Tickets {
  id                                  String                 @id @db.Uuid
  public_id                           String                 @unique @db.VarChar(50)
  purchase_order_id                   String                 @db.Uuid
  user_id                             String                 @db.Uuid
  draw_event_id                       String                 @db.Uuid
  combination_id                      String                 @unique @db.Uuid
  rule_version_id                     String                 @db.Uuid
  normalized_key                      String                 @db.VarChar(80)
  price_virtual_minor                 BigInt
  ownership_status                    TicketOwnershipStatus
  evaluation_status                   TicketEvaluationStatus
  credit_status                       TicketCreditStatus
  purchase_ledger_transaction_id      String                 @db.Uuid
  purchased_at                        DateTime               @db.Timestamptz(6)

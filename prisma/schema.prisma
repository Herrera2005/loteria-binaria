// Lotería Binaria — schema.prisma v1.0.0
// Traducción directa de DICCIONARIO-DE-DATOS.md v1.1.0.
// Prisma ORM 7.9.x + PostgreSQL 16.
// UUID v7 se genera en la aplicación; por eso las PK UUID no usan @default(uuid()).
// CHECK, triggers, vistas, índices parciales e integridad diferida viven en prisma/sql/.

generator client {
  provider     = "prisma-client"
  output       = "../apps/api/src/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "cjs"
}

datasource db {
  provider     = "postgresql"
  relationMode = "foreignKeys"
}


/// Evaluación inmutable por boleto.
model TicketEvaluations {
  id                                    String                 @id @db.Uuid
  draw_event_id                         String                 @db.Uuid
  ticket_id                             String                 @unique @db.Uuid
  draw_result_id                        String                 @db.Uuid
  match_count                           Int                    @db.SmallInt
  evaluation_category                   TicketEvaluationStatus
  evaluation_hash                       String                 @db.VarChar(128)
  evaluated_at                          DateTime               @db.Timestamptz(6)
  created_at                            DateTime               @default(now()) @db.Timestamptz(6)
  rel_draw_event_id                     DrawEvents             @relation("fk_ticket_evaluations_draw_event_id", fields: [draw_event_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  rel_ticket_id                         Tickets                @relation("fk_ticket_evaluations_ticket_id", fields: [ticket_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  rel_ticket_event                      Tickets                @relation("fk_evaluation_ticket_event", fields: [ticket_id, draw_event_id], references: [id, draw_event_id], onDelete: Restrict, onUpdate: Cascade, map: "fk_evaluation_ticket_event")

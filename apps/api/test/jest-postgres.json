{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testMatch": [
    "<rootDir>/test/postgres/**/*.pg-spec.ts"
  ],
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "tsconfig": "<rootDir>/test/tsconfig.json"
      }
    ]
  },
  "testEnvironment": "node",
  "testTimeout": 120000,
  "maxWorkers": 1,
  "detectOpenHandles": true,
  "clearMocks": true,
  "restoreMocks": true,
  "verbose": true
}
